POSTGRES_DB=dinhguide
POSTGRES_USER=dinhguide
POSTGRES_PASSWORD=local_demo_password_change_me
JWT_SECRET=replace_with_a_long_random_secret_for_local_demo
FRONTEND_PORT=8080
GATEWAY_PORT=4000
AUTH_SERVICE_URL=http://auth-service:4101
ATTRACTION_SERVICE_URL=http://attraction-service:4102
NARRATION_SERVICE_URL=http://narration-service:4103
FEEDBACK_SERVICE_URL=http://feedback-service:4104
ANALYTICS_SERVICE_URL=http://analytics-service:4105
DATABASE_URL=postgres://dinhguide:local_demo_password_change_me@postgres:5432/dinhguide

# Optional GHCR image namespace for deployment
IMAGE_OWNER=local
IMAGE_TAG=local

# Optional PostgreSQL -> SQL Server live data mirror.
# Enable with COMPOSE_PROFILES=sqlserver-sync after configuring SQL Server TCP/IP and SQL authentication.
# Set these in your local .env file; do not commit real credentials.
# COMPOSE_PROFILES=sqlserver-sync
# SQLSERVER_HOST=host.docker.internal
# SQLSERVER_PORT=1433
# SQLSERVER_DATABASE=DinhGuide
# SQLSERVER_USER=dinhguide_sync
# SQLSERVER_PASSWORD=replace_with_a_local_sql_login_password
# SQLSERVER_ENCRYPT=false
# SQLSERVER_TRUST_CERT=true
# SYNC_INTERVAL_MS=10000

